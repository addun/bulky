{{> header}}
<h1>{{#if new}}Add comparison group{{else}}Edit comparison group{{/if}}</h1>
<form class="stack" method="post" action="{{#if new}}/admin/comparison-groups{{else}}/admin/comparison-groups/{{group.id}}{{/if}}">
  <fieldset class="form-group">
    <legend>Group</legend>
    <label>Name <input name="name" required value="{{group.name}}" autofocus></label>
    <label>
      Compare in
      <select name="unit_id" required>
        <option value="">Select…</option>
        {{#each units}}
        <option value="{{this.id}}" {{#if (eq this.id ../group.unitId)}}selected{{/if}}>{{this.name}}</option>
        {{/each}}
      </select>
    </label>
    <p class="hint">Members need this as their purchase unit, or a conversion to it. Rankings use the latest logged price per kg, litre, or whichever unit you pick.</p>
  </fieldset>

  <fieldset class="form-group">
    <legend>Products</legend>
    {{#unless products}}
      <p class="hint">No products yet. <a href="/admin/products/new">Add a product</a> first.</p>
    {{else}}
      <div class="checks">
        {{#each products}}
        <label class="check"><input type="checkbox" name="product_id" value="{{this.id}}" {{#if this.selected}}checked{{/if}}> {{this.name}} <span class="meta">{{this.unitName}}</span></label>
        {{/each}}
      </div>
    {{/unless}}
  </fieldset>

  <div class="form-actions">
    <button type="submit" class="btn btn-tag">{{#if new}}Add group{{else}}Save group{{/if}}</button>
    <a href="/admin/comparison-groups">Cancel</a>
  </div>
</form>
{{> footer}}
