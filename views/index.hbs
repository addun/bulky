{{> header}}
{{#if (gt imported 0)}}
<p class="banner">Saved {{imported}} purchase{{#if (ne imported 1)}}s{{/if}} from the bill.</p>
{{/if}}
<div class="toolbar">
  <form class="search" method="get" action="/admin">
    <label class="sr" for="q">Search</label>
    <input id="q" name="q" type="search" value="{{page.query}}" placeholder="Find a product" autocomplete="off">
    <button type="submit" class="btn btn-tag">Search</button>
  </form>
</div>

{{#unless products}}
  <div class="empty">
    {{#if page.query}}
      <p>No product matches “{{page.query}}”.</p>
    {{else}}
      <p>Nothing on the list yet.</p>
      <p><a href="/admin/products/new">Add the first product you buy in bulk</a>, or <a href="/admin/receipts">scan a bill</a>.</p>
    {{/if}}
  </div>
{{else}}
  <ul class="ledger">
    {{#each products}}
    <li>
      <a class="row" href="/admin/products/{{this.id}}">
        {{#if this.imagePath}}
          <img class="thumb" src="/images/{{this.imagePath}}" alt="">
        {{else}}
          <span class="thumb thumb-empty" aria-hidden="true"></span>
        {{/if}}
        <span class="row-main">
          <strong>{{this.name}}</strong>
          <span class="meta">{{this.unitName}}{{#if this.lastBought}} · last {{datetime this.lastBought}}{{/if}}</span>
        </span>
        <span class="row-amt">{{#if this.quote}}{{money this.quote.price}} / {{this.unitName}}{{else}}—{{/if}}</span>
      </a>
    </li>
    {{/each}}
  </ul>
{{/unless}}
{{> footer}}
