{{> header}}
<article class="product-head">
  {{#if Product.ImagePath.Valid}}
    <img class="hero" src="/images/{{Product.ImagePath.String}}" alt="">
  {{else}}
    <span class="hero hero-empty" aria-hidden="true"></span>
  {{/if}}
  <div>
    <h1>{{Product.Name}}</h1>
  </div>
</article>

<section class="price-stats">
  <div>
    {{#if Quote}}
      {{#if Quote.IsLast30Days}}
        <p class="eyebrow">Lowest · 30 days</p>
      {{else}}
        <p class="eyebrow">Last recorded</p>
      {{/if}}
      <p class="price-stat">{{money Quote.Price}} / {{Product.UnitName}}</p>
      {{#each (extraQuotes Quote Product)}}
      <p class="price-extra">{{money this.Price}} / {{this.UnitName}}</p>
      {{/each}}
      <p class="meta">{{date Quote.BoughtOn}}</p>
    {{else}}
      <p class="eyebrow">Lowest · 30 days</p>
      <p class="price-stat">—</p>
    {{/if}}
  </div>
</section>

<section>
  <h2>Last 365 days</h2>
  {{#if HasChart}}
    <div class="price-chart" data-price-chart="{{ChartJSON}}" data-chart-from="{{ChartFrom}}" data-chart-to="{{ChartTo}}" data-chart-symbol="{{Page.Symbol}}"></div>
  {{else}}
    <p class="empty">No prices in the last year.</p>
  {{/if}}
</section>

{{#if Related}}
<section>
  <h2>Check also</h2>
  <ul class="ledger">
    {{#each Related}}
    <li>
      <a class="row" href="/products/{{this.ID}}">
        {{#if this.ImagePath.Valid}}
          <img class="thumb" src="/images/{{this.ImagePath.String}}" alt="">
        {{else}}
          <span class="thumb thumb-empty" aria-hidden="true"></span>
        {{/if}}
        <span class="row-main">
          <strong>{{this.Name}}</strong>
        </span>
        <span class="row-amt">{{money this.Quote.Price}} / {{this.UnitName}}</span>
      </a>
    </li>
    {{/each}}
  </ul>
</section>
{{/if}}
{{> footer}}
