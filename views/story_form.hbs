{{> header}}
<h1>{{#if New}}Add store{{else}}Edit store{{/if}}</h1>
<form class="stack" method="post" action="{{#if New}}/admin/stories{{else}}/admin/stories/{{Story.ID}}{{/if}}">
  {{#if Next}}<input type="hidden" name="next" value="{{Next}}">{{/if}}
  <fieldset class="form-group">
    <legend>Name</legend>
    <label>Name <input name="name" required value="{{Story.Name}}" autofocus></label>
    <label>
      Retail chain
      <select name="retail_chain_id">
        <option value="">None</option>
        {{#each RetailChains}}
        <option value="{{this.ID}}" {{#if (eq this.ID ../Story.RetailChainID)}}selected{{/if}}>{{this.Label}}</option>
        {{/each}}
      </select>
    </label>
    <label><span>Store code <span class="hint">optional · printed on the bill</span></span> <input name="external_id" value="{{Story.ExternalID}}"></label>
    {{#unless RetailChains}}
      <p class="hint">No retail chains yet. You can still save, or <a href="/admin/retail-chains/new">add a chain</a> first.</p>
    {{/unless}}
  </fieldset>
  <fieldset class="form-group">
    <legend>Address</legend>
    <label>Street name <input name="street_name" required value="{{Story.StreetName}}" autocomplete="street-address"></label>
    <div class="form-row">
      <label>Building number <input name="building_number" required value="{{Story.BuildingNumber}}"></label>
      <label><span>Apartment number <span class="hint">optional</span></span> <input name="apartment_number" value="{{Story.ApartmentNumber}}"></label>
    </div>
    <div class="city-row">
      <label>Postal code <input name="postal_code" required value="{{Story.PostalCode}}" autocomplete="postal-code"></label>
      <label>City <input name="city" required value="{{Story.City}}"></label>
    </div>
  </fieldset>
  <div class="form-actions">
    <button type="submit" class="btn btn-tag">{{#if New}}Add store{{else}}Save store{{/if}}</button>
    <a href="{{#if Next}}{{Next}}{{else}}/admin/stories{{/if}}">Cancel</a>
  </div>
</form>
{{> footer}}
