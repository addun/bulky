{{> header}}
<div class="page-head">
  {{#if filter}}
  <div>
    <h1>Aliases for {{filter.name}}</h1>
    <p class="hint"><a href="/admin/aliases">All aliases</a></p>
  </div>
  <a class="btn btn-tag" href="/admin/aliases/new?product={{filter.id}}">Add alias</a>
  {{else}}
  <h1>Aliases</h1>
  <a class="btn btn-tag" href="/admin/aliases/new">Add alias</a>
  {{/if}}
</div>

{{#unless aliases}}
  <p class="empty">{{#if filter}}No aliases for this product.{{else}}No aliases yet.{{/if}}</p>
{{else}}
  <ul class="units aliases">
    {{#each aliases}}
    <li>
      <span class="row-main">
        <span class="unit-name">{{this.alias}}</span>
        <span class="meta">{{this.productName}} · {{this.scopeLabel}}</span>
      </span>
      <span class="tight">
        <a href="/admin/aliases/{{this.id}}/edit{{../productQuery}}">Edit</a>
        <a class="danger" href="/admin/aliases/{{this.id}}/delete{{../productQuery}}">Delete</a>
      </span>
    </li>
    {{/each}}
  </ul>
{{/unless}}
{{> footer}}
