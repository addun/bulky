{{> header}}
<h1>Change unit for {{Product.Name}}</h1>
{{#unless Product.Conversions}}
<p class="lede">Add a conversion first, then you can make that unit the purchase unit.</p>
<p><a href="/admin/products/{{Product.ID}}/edit">Edit conversions</a> · <a href="/admin/products/{{Product.ID}}">Cancel</a></p>
{{else}}
{{#if History}}
<p class="lede">This converts {{History}} logged buy{{#if (ne History 1)}}s{{/if}} using the extra unit's factor.</p>
{{/if}}
<form class="stack" method="post" action="/admin/products/{{Product.ID}}/change-unit" data-change-unit>
  <label>
    New unit
    <select name="unit_id" required>
      <option value="">Select…</option>
      {{#each Product.Conversions}}
      <option value="{{this.UnitID}}" data-factor="{{qty this.Factor}}" {{#if (eq this.UnitID ../NewUnitID)}}selected{{/if}}>{{this.UnitName}}</option>
      {{/each}}
    </select>
  </label>
  <p class="extra-eq">
    <span class="extra-eq-lead">1 {{Product.UnitName}} equals</span>
    <span data-change-factor></span>
    <span data-new-unit>new unit</span>
  </p>
  <div class="actions">
    <button type="submit" class="btn btn-tag">Change unit</button>
    <a href="/admin/products/{{Product.ID}}">Cancel</a>
  </div>
</form>
{{/unless}}
{{> footer}}
