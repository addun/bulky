{{> header}}
<div class="page-head">
  <h1>Retail chains</h1>
  <a class="btn btn-tag" href="/admin/retail-chains/new">Add chain</a>
</div>

{{#unless RetailChains}}
  <p class="empty">No retail chains yet.</p>
{{else}}
  <ul class="units">
    {{#each RetailChains}}
    <li>
      <span class="row-main">
        <span class="unit-name">{{this.Name}}</span>
        <span class="meta">{{this.LegalName}} · {{this.TaxID}}</span>
      </span>
      <span class="meta">{{this.StoryCount}} store{{#if (ne this.StoryCount 1)}}s{{/if}}</span>
      <span class="tight">
        <a href="/admin/retail-chains/{{this.ID}}/edit">Edit</a>
        {{#if (eq this.StoryCount 0)}}
          <a class="danger" href="/admin/retail-chains/{{this.ID}}/delete">Delete</a>
        {{/if}}
      </span>
    </li>
    {{/each}}
  </ul>
{{/unless}}
{{> footer}}
