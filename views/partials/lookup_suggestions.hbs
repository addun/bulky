{{#if query}}
{{#if products}}
<ul class="ledger lookup-results">
  {{#each products}}
  <li>
    <a class="row" href="/products/{{this.product.id}}">
      {{#if this.product.imagePath}}
        <img class="thumb" src="/images/{{this.product.imagePath}}" alt="">
      {{else}}
        <span class="thumb thumb-empty" aria-hidden="true"></span>
      {{/if}}
      <span class="row-main">
        <strong>{{this.product.name}}</strong>
        {{#unless this.quote}}
        <span class="meta">{{this.product.unitName}}</span>
        {{/unless}}
      </span>
      {{#if this.quote}}
      <span class="row-amt">{{money this.quote.price}} / {{this.product.unitName}}</span>
      {{/if}}
    </a>
  </li>
  {{/each}}
</ul>
{{else}}
<p class="empty lookup-empty">No product matches.</p>
{{/if}}
{{/if}}
