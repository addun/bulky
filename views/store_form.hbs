{{> header}}
<h1>{{#if new}}Add store{{else}}Edit store{{/if}}</h1>
<form class="stack" method="post" action="{{#if new}}/admin/stores{{else}}/admin/stores/{{store.id}}{{/if}}">
  {{#if next}}<input type="hidden" name="next" value="{{next}}">{{/if}}
  <fieldset class="form-group">
    <legend>Name</legend>
    <label>Name <input name="name" required value="{{store.name}}" autofocus></label>
    <label>
      Retail chain
      <select name="retail_chain_id">
        <option value="">None</option>
        {{#each retailChains}}
        <option value="{{this.id}}" {{#if (eq this.id ../store.retailChainId)}}selected{{/if}}>{{this.label}}</option>
        {{/each}}
      </select>
    </label>
    <label><span>Store code <span class="hint">optional · printed on the bill</span></span> <input name="external_id" value="{{store.externalId}}"></label>
    {{#unless retailChains}}
      <p class="hint">No retail chains yet. You can still save, or <a href="/admin/retail-chains/new">add a chain</a> first.</p>
    {{/unless}}
  </fieldset>
  <fieldset class="form-group">
    <legend>Address</legend>
    <label>Street name <input name="street_name" required value="{{store.streetName}}" autocomplete="street-address"></label>
    <div class="form-row">
      <label>Building number <input name="building_number" required value="{{store.buildingNumber}}"></label>
      <label><span>Apartment number <span class="hint">optional</span></span> <input name="apartment_number" value="{{store.apartmentNumber}}"></label>
    </div>
    <div class="city-row">
      <label>Postal code <input name="postal_code" required value="{{store.postalCode}}" autocomplete="postal-code"></label>
      <label>City <input name="city" required value="{{store.city}}"></label>
    </div>
    <div class="form-row">
      <label><span>Latitude <span class="hint">optional</span></span> <input name="lat" inputmode="decimal" value="{{store.lat}}"></label>
      <label><span>Longitude <span class="hint">optional</span></span> <input name="lng" inputmode="decimal" value="{{store.lng}}"></label>
    </div>
  </fieldset>
  <div class="form-actions">
    <button type="submit" class="btn btn-tag">{{#if new}}Add store{{else}}Save store{{/if}}</button>
    <a href="{{#if next}}{{next}}{{else}}/admin/stores{{/if}}">Cancel</a>
  </div>
</form>
{{> footer}}
