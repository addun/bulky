{{> header}}
<div class="page-head">
  <h1>Stores</h1>
  <a class="btn btn-tag" href="/admin/stories/new">Add store</a>
</div>

{{#unless stories}}
  <p class="empty">No stores yet.</p>
{{else}}
  <ul class="units stories">
    {{#each stories}}
    <li>
      <span class="row-main">
        <span class="unit-name">{{this.name}}</span>
        {{#if this.retailChainName}}<span class="meta">{{this.retailChainName}}</span>{{/if}}
        {{#if this.externalId}}<span class="meta">{{this.externalId}}</span>{{/if}}
        <span class="meta story-addr">{{this.addressLine}}</span>
      </span>
      <span class="meta">{{this.purchaseCount}} purchase{{#if (ne this.purchaseCount 1)}}s{{/if}}</span>
      <span class="tight">
        <a href="/admin/stories/{{this.id}}/edit">Edit</a>
        {{#if (eq this.purchaseCount 0)}}
          <a class="danger" href="/admin/stories/{{this.id}}/delete">Delete</a>
        {{/if}}
      </span>
    </li>
    {{/each}}
  </ul>
{{/unless}}
{{> footer}}
