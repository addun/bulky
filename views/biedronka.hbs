{{> header}}
<h1>Biedronka import</h1>
<p class="lede">Import e-bills from Moja Biedronka as saved purchases. Already imported bills are skipped. Tokens stay in this page, not in the database.</p>
<div id="biedronka-imported" hidden data-payload="{{importedJSON}}"></div>

<div id="biedronka-signed-out" class="stack">
  <div class="form-actions">
    <button type="button" class="btn btn-tag" id="biedronka-signin">Sign in with Moja Biedronka</button>
  </div>
  <label>Auth URL
    <textarea id="biedronka-code" rows="3" spellcheck="false" autocapitalize="off" autocomplete="off"></textarea>
    <span class="hint" id="biedronka-code-hint"></span>
  </label>
  <div class="form-actions">
    <button type="button" class="btn btn-tag" id="biedronka-finish">Finish sign-in</button>
  </div>
</div>

<div id="biedronka-signed-in" hidden>
  <p class="meta" id="biedronka-session"></p>
  <div class="form-actions">
    <button type="button" class="btn btn-plain" id="biedronka-clear">Sign out</button>
  </div>
</div>

<p class="meta" id="biedronka-status"></p>

<div id="biedronka-results" hidden>
  <div class="page-head">
    <h2>Bills</h2>
    <button type="button" class="btn btn-tag" id="biedronka-import-all">Import all</button>
  </div>
  <div class="table-wrap">
    <table class="data-table" id="biedronka-table">
      <thead>
        <tr>
          <th>Date</th>
          <th>Store</th>
          <th>Total</th>
          <th></th>
        </tr>
      </thead>
      <tbody></tbody>
    </table>
  </div>
  <div class="form-actions">
    <button type="button" class="btn btn-plain" id="biedronka-more" hidden>Load more</button>
  </div>
</div>
<script src="/static/biedronka.js?v=empty-row"></script>
{{> footer}}
