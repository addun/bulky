{{> header}}
<h1>Confirm the bill</h1>
<p class="lede">Products from this bill. Check each line, then save as purchases.</p>

{{#if view.migrated}}<p class="banner">This bill is already saved as purchases.</p>{{/if}}
{{#if view.notes}}<p class="banner">{{view.notes}}</p>{{/if}}

<div class="receipt-layout">
  {{#if view.imagePath}}
  <figure class="receipt-slip">
    <img src="/admin/receipts/{{view.receiptId}}/preview" alt="Uploaded bill">
  </figure>
  {{/if}}

  <form class="stack" method="post" action="/admin/receipts/{{view.receiptId}}" id="receipt-review">
    <input type="hidden" name="receipt_id" value="{{view.receiptId}}">
    <input type="hidden" name="image_path" value="{{view.imagePath}}">
    <input type="hidden" name="notes" value="{{view.notes}}">
    <input type="hidden" name="line_count" id="line-count" value="{{len view.lines}}">

    <fieldset class="form-group">
      <legend>Visit</legend>
      <div class="form-row">
        <label>Date <input type="date" name="bought_on" required value="{{dateValue view.boughtOn}}"></label>
        <label>Hour <input type="time" name="bought_at" value="{{view.boughtAt}}"></label>
      </div>
      <label>
        Store
        <select name="story_id">
          <option value="">None</option>
          {{#each stories}}
          <option value="{{this.id}}" {{#if (eq this.id ../view.storyId)}}selected{{/if}}>{{this.label}}</option>
          {{/each}}
        </select>
      </label>
      {{#if view.addressLine}}<p class="hint">Address on the bill: {{view.addressLine}}</p>{{/if}}
      {{#if view.createStoryUrl}}<p><a class="btn btn-ghost" href="{{view.createStoryUrl}}">Create store</a></p>{{/if}}
      {{#if (and (not stories) (not view.createStoryUrl))}}<p class="hint">No stores yet. You can still save, or <a href="/admin/stories/new">add a store</a> first.</p>{{/if}}
      <input type="hidden" name="story_name" value="{{view.storyName}}">
      <input type="hidden" name="external_id" value="{{view.externalId}}">
      <input type="hidden" name="street_name" value="{{view.streetName}}">
      <input type="hidden" name="building_number" value="{{view.buildingNumber}}">
      <input type="hidden" name="apartment_number" value="{{view.apartmentNumber}}">
      <input type="hidden" name="postal_code" value="{{view.postalCode}}">
      <input type="hidden" name="city" value="{{view.city}}">
    </fieldset>

    <h2>Products</h2>
    <div id="receipt-lines">
      {{#each view.lines}}
      <fieldset class="receipt-line{{#unless this.include}} is-off{{/unless}}" data-qty-form data-qty-symbol="{{../page.symbol}}">
        <legend class="sr">Line {{add @index 1}}</legend>
        <label class="check receipt-include">
          <input type="checkbox" name="include_{{@index}}" value="1" {{#if this.include}}checked{{/if}}>
          Include
        </label>
        {{#if this.receiptName}}<p class="meta bill-text">On the bill: {{this.receiptName}}{{#if this.vatType}} · VAT {{this.vatType}}{{/if}}{{#if this.unitPrice}} · {{this.quantity}} × {{this.unitPrice}}{{/if}}{{#if this.discount}} · rabat {{this.discount}}{{/if}}</p>{{/if}}
        <input type="hidden" name="vat_type_{{@index}}" value="{{this.vatType}}">
        <input type="hidden" name="unit_price_{{@index}}" value="{{this.unitPrice}}">
        <input type="hidden" name="discount_{{@index}}" value="{{this.discount}}">
        <input type="hidden" name="ean_{{@index}}" value="{{this.ean}}">
        <label>Alias <input name="receipt_name_{{@index}}" value="{{this.receiptName}}"></label>
        <label>
          Product
          <select name="product_choice_{{@index}}" data-product-choice>
            <option value="new" {{#if (eq this.productId 0)}}selected{{/if}}>New product</option>
            {{#each ../products}}
            <option value="{{this.id}}" {{#if (eq this.id ../productId)}}selected{{/if}}>{{this.name}} ({{this.unitName}})</option>
            {{/each}}
          </select>
        </label>
        <label{{#if this.productId}} hidden{{/if}} data-new-name>Name <input name="product_name_{{@index}}" value="{{this.productName}}"></label>
        <div class="receipt-nums">
          <label>Quantity <input name="quantity_{{@index}}" inputmode="decimal" value="{{this.quantity}}" data-qty></label>
          <label{{#if this.productId}} hidden{{/if}} data-new-unit>
            Unit
            <select name="unit_id_{{@index}}">
              <option value="">Select…</option>
              {{#each ../units}}
              <option value="{{this.id}}" {{#if (and (eq ../productId 0) (eq this.id ../unitId))}}selected{{/if}}>{{this.name}}</option>
              {{/each}}
            </select>
          </label>
          <label>Amount ({{../page.currency}}) <input name="amount_{{@index}}" inputmode="decimal" value="{{this.amount}}" data-qty-amount></label>
        </div>
        <p class="hint pack-total" data-qty-total hidden></p>
      </fieldset>
      {{/each}}
    </div>
    <p>{{#unless view.migrated}}<button type="button" class="btn btn-ghost" id="add-line">Add a product</button>{{/unless}}</p>
    <div class="actions">
      {{#unless view.migrated}}<button type="submit" class="btn btn-tag">Save purchases</button>{{/unless}}
    </div>
  </form>
</div>

<template id="receipt-line-template">
  <fieldset class="receipt-line" data-qty-form data-qty-symbol="{{page.symbol}}">
    <legend class="sr">New line</legend>
    <label class="check receipt-include">
      <input type="checkbox" name="include___I__" value="1" checked>
      Include
    </label>
    <input type="hidden" name="ean___I__" value="">
    <label>Alias <input name="receipt_name___I__" value=""></label>
    <label>
      Product
      <select name="product_choice___I__" data-product-choice>
        <option value="new" selected>New product</option>
        {{#each products}}
        <option value="{{this.id}}">{{this.name}} ({{this.unitName}})</option>
        {{/each}}
      </select>
    </label>
    <label data-new-name>Name <input name="product_name___I__" value=""></label>
    <div class="receipt-nums">
      <label>Quantity <input name="quantity___I__" inputmode="decimal" value="" data-qty></label>
      <label data-new-unit>
        Unit
        <select name="unit_id___I__">
          <option value="">Select…</option>
          {{#each units}}
          <option value="{{this.id}}">{{this.name}}</option>
          {{/each}}
        </select>
      </label>
      <label>Amount ({{page.currency}}) <input name="amount___I__" inputmode="decimal" value="" data-qty-amount></label>
    </div>
    <p class="hint pack-total" data-qty-total hidden></p>
  </fieldset>
</template>
{{> footer}}
