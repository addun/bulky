{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "paths": {
      "@app/store": ["./src/store"],
      "@app/store/units": ["./src/store/units"],
      "@app/store/locations": ["./src/store/locations"],
      "@app/store/aliases": ["./src/store/aliases"],
      "@app/store/purchases": ["./src/store/purchases"],
      "@app/store/comparison-groups": ["./src/store/comparison-groups"],
      "@app/store/products": ["./src/store/products"],
      "@app/store/receipts": ["./src/store/receipts"],
      "@app/store/*": ["./src/store/*"]
    }
  },
  "include": ["src/**/*"]
}
