{{> header}}
<h1>Edit visit</h1>
<p class="lede">Date and store for this bill.</p>
<p class="hint">Saving applies these values to every product assigned to this receipt.</p>

<form class="stack" method="post" action="/admin/receipts/{{receipt.id}}/edit">
  <fieldset class="form-group">
    <legend>When</legend>
    <label>Date and hour <input type="datetime-local" name="bought_on" required value="{{datetimeLocal boughtOn}}"></label>
  </fieldset>

  <fieldset class="form-group">
    <legend>Store</legend>
    <label>
      Store
      <select name="store_id">
        <option value="">None</option>
        {{#each stores}}
        <option value="{{this.id}}" {{#if (eq this.id ../store.id)}}selected{{/if}}>{{this.label}}</option>
        {{/each}}
      </select>
    </label>
    {{#unless stores}}<p class="hint">No stores yet. You can still save, or <a href="/admin/stores/new">add a store</a> first.</p>{{/unless}}
  </fieldset>

  <div class="actions">
    <button type="submit" class="btn btn-tag">Save visit</button>
    <a href="/admin/receipts/{{receipt.id}}">Cancel</a>
  </div>
</form>
<p class="danger-zone">
  <a class="danger" href="/admin/receipts/{{receipt.id}}/delete">Delete receipt</a>
</p>
{{> footer}}
