{{#if (eq mode "search")}}
  {{#if products}}
  <h2 class="promo-kicker">Wyniki</h2>
  <ul class="promo-grid">
    {{#each products}}
    {{> promo_card}}
    {{/each}}
  </ul>
  {{else}}
  <p class="empty lookup-empty">Brak pasujących produktów.</p>
  {{/if}}
{{else}}
  {{#if products}}
  <h2 class="promo-kicker">Popularne teraz</h2>
  <ul class="promo-grid">
    {{#each products}}
    {{> promo_card}}
    {{/each}}
  </ul>
  {{else}}
  <p class="empty lookup-empty">Na liście nic jeszcze nie ma. Zeskanuj paragon w panelu, żeby zacząć.</p>
  {{/if}}
{{/if}}
